{
  "name": "LOGILINK",
  "private": true,
  "version": "0.12.5",
  "description": "Logilink App",
  "title": "LOGILINK PRO",
  "author": {
    "name": "Intercocina",
    "email": "webmaster@intercocina.com"
  },
  "type": "module",
  "main": "src/electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/hagmir7/logilink.git"
  },
  "homepage": "https://intercocina.com",

  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",

    "build": "vite build",
    "build:win": "npm run build && electron-builder --win --x64",
    "publish": "npm run build && electron-builder --win --x64 --publish always",

    "build:linux": "npm run build && electron-builder --linux --x64",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "lint": "eslint .",
    "preview": "vite preview"
  },

  "dependencies": {
    "@ant-design/plots": "^2.6.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ericblade/quagga2": "^1.8.0",
    "@fontsource/inter": "^5.2.5",
    "@tailwindcss/vite": "^4.1.4",
    "@yudiel/react-qr-scanner": "^2.3.1",
    "antd": "^5.24.9",
    "antd-style": "^3.7.1",
    "apexcharts": "^5.6.0",
    "axios": "^1.9.0",
    "bwip-js": "^4.8.0",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.6.2",
    "html5-qrcode": "^2.3.8",
    "lodash": "^4.17.21",
    "lucide-react": "^0.577.0",
    "react": "^18.0.0",
    "react-apexcharts": "^2.0.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.5.3",
    "recharts": "^3.9.0"
  },

  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.21.0",
    "@types/react": "^18.0.10",
    "@types/react-dom": "^18.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "electron-winstaller": "^5.4.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.11",
    "vite": "^6.2.0"
  },

  "build": {
    "appId": "com.intercocina.logilink",
    "productName": "LOGILINK",
    "copyright": "Copyright Intercocina",

    "directories": {
      "output": "dist",
      "buildResources": "build"
    },

    "files": [
      "**/*",
      "!**/.vscode/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml}",
      "!{dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml}"
    ],

    "asar": true,

    "asarUnpack": [
      "resources/**"
    ],

    "artifactName": "LOGILINK-Setup-${version}.${ext}",

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/inter.png",
      "executableName": "LOGILINK"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LOGILINK",
      "uninstallDisplayName": "LOGILINK",
      "deleteAppDataOnUninstall": false
    },

    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "logilink",
      "icon": "build/inter.png",
      "category": "Office"
    },

    "npmRebuild": false,

    "publish": {
      "provider": "github",
      "owner": "hagmir7",
      "repo": "logilink",
      "releaseType": "release"
    },

    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}